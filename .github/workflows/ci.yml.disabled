name: vibrasense-ci

on:
  push:
    branches:
      - main
      - develop
      - dev/version*
  pull_request:
    branches:
      - main
      - develop

jobs:
  python:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r software/requirements.txt -r requirements-dev.txt
      - name: Syntax check
        run: make syntax-check
      - name: Lint
        run: make lint
      - name: Tests
        run: make test

  security:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Reject sensitive paths
        run: |
          if git ls-files | grep -E '(^|/)(\.env|\.pem|\.key|id_glad\*|vibrasense\.db)$'; then exit 1; fi
      - name: Reject unsafe artefact loading
        run: |
          if git grep -nE 'weights_only=False|pickle\.load|joblib\.load|allow_pickle=True' -- software ml tests; then exit 1; fi
      - name: Dependency audit
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r software/requirements.txt -r requirements-dev.txt
          python -m pip_audit -r software/requirements.txt -r requirements-dev.txt

  firmware:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install PlatformIO
        run: python -m pip install platformio==6.1.18
      - name: Compile firmware
        run: pio run -d firmware/vibrasense_node
